# Run this first: yosys synth_baseline.ys
# Produces pe_baseline_syn.v -- the gate-level netlist OpenROAD needs.
# (OpenROAD does not synthesize RTL itself -- this step is required.)

read_verilog ../rtl/pe_baseline_bf16.v
hierarchy -top pe_bf16_ws
proc; opt; fsm; opt; memory; opt
techmap; opt
dfflibmap -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
opt_clean
write_verilog -noattr pe_baseline_syn.v
stat -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
